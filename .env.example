# ---------------------------------------------------------------------------
# Environment variable reference for the Skin-Lesion AI application.
#
# Copy this file to .env for LOCAL development only (.env is git-ignored).
# Never put real credentials in this example file.
#
# For Render production deployment, set these values in the Render
# dashboard (or render.yaml) instead of any committed file. Render injects
# DATABASE_URL automatically from the blueprint's PostgreSQL resource.
# ---------------------------------------------------------------------------

# Optional: paths to the trained inference artifacts. Defaults are relative
# to the repository root and work unchanged on Render, so you normally do
# NOT need to set these.
SKIN_MODEL_PATH=training_output/mobilenetv2_ham10000/best_model.pt
SKIN_MAPPING_PATH=training_output/mobilenetv2_ham10000/class_label_mapping.json
SKIN_PREPROCESSING_PATH=training_output/mobilenetv2_ham10000/inference_preprocessing.json

# Comma-separated list of browser origins allowed to call the API.
# Local development defaults: http://localhost:3000,http://localhost:5173
# On Render, set this to your deployed frontend URL, for example:
#   CORS_ORIGINS=https://skin-lesion-ai-site.onrender.com
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Upload safety limits (bytes / total pixels).
MAX_UPLOAD_BYTES=10485760
MAX_IMAGE_PIXELS=20000000

# Maximum width or height for the inline original/Grad-CAM images returned
# by the /explain endpoint.
MAX_EXPLANATION_IMAGE_DIMENSION=1024

# PostgreSQL prediction-history storage. Credentials live ONLY in a local
# git-ignored .env file or in real environment variables — never in code.
# Local example (PostgreSQL 16 service on this machine, port 5433):
#   DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@127.0.0.1:5433/skin_lesion_ai
# On Render, do NOT set this manually: the blueprint wires DATABASE_URL to
# the managed PostgreSQL database automatically.
DATABASE_URL=

# Frontend note (set in frontend/.env or as a Render build-time variable,
# NOT here): VITE_API_BASE_URL is baked into the static bundle at build
# time, e.g. https://skin-lesion-ai-api.onrender.com. When unset, the
# frontend falls back to http://127.0.0.1:8000 for local development.
