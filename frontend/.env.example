# Frontend environment variables (Vite). Copy to frontend/.env for local
# overrides. On Render, set these in the Static Site -> Environment settings.
#
# Production API base URL, baked into the bundle at build time, e.g.:
#   VITE_API_BASE_URL=https://skin-lesion-ai-api.onrender.com
# When unset the app falls back to http://127.0.0.1:8000 for local development.
VITE_API_BASE_URL=
